<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Platform DayNight parent so the window follows the system dark-mode setting —
      which is exactly what ZenDeviceEffects.setShouldUseNightMode is supposed to flip.
    -->
    <style name="Theme.ZenSpike" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
