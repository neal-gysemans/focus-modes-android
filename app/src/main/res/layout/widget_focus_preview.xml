<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker draws.

  A static stand-in for the 2x1 layout that widget/FocusWidget composes: the same rounded
  card, the same filled circular chip, the same name beside it, and the same hairline and
  chevron zone on the trailing edge. It is a hand-written layout rather than a rendered
  bitmap so it follows the device's light/dark setting (the colours below have a
  values-night variant) and stays sharp at any picker density.

  The chevron is in here because it is the half of the control a new user has no other way
  to discover: "tap the left to toggle, tap the right to choose" has to be visible in the
  picker, or the second zone is a secret.

  Deliberately shows a mode as *on*: a picker preview of the off state would be a grey
  ring and the word "Focus", which tells the user nothing about what the widget does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_preview_chip"
        android:contentDescription="@string/widget_label"
        android:padding="9dp"
        android:src="@drawable/ic_mode_briefcase"
        android:tint="@android:color/white" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_mode"
        android:textColor="@color/widget_preview_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- An ImageView, not a plain View: a widget layout may only use the classes
         RemoteViews allows, and a bare View makes the launcher refuse the whole preview
         ("Couldn't add widget"). Guarded by WidgetLayoutClassesTest. -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/widget_preview_hairline"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/widget_choose_mode"
        android:src="@drawable/ic_chevron_updown"
        android:tint="@color/widget_preview_muted" />

</LinearLayout>
