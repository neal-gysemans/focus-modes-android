<?xml version="1.0" encoding="utf-8"?>
<!--
  Navigation-up arrow for the mode editor's top bar. Tinted at the call site, like
  every other drawable here — no ?attr/ reference, because the app has no appcompat
  theme attributes to resolve one against.

  Hand-drawn rather than pulled from compose-material-icons: that artifact is not a
  dependency, and adding a whole icon set to draw one arrow is not a trade worth
  making in an app whose only other icons are seven bundled glyphs.

  autoMirrored so the arrow points the other way in a right-to-left layout.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:autoMirrored="true"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FF000000"
        android:pathData="M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z" />
</vector>
