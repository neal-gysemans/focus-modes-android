<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Focus Modes</string>
    <!-- Quick Settings tile label. Kept short: the platform truncates past ~18 chars,
         and HyperOS hides it entirely, so it must never be load-bearing. -->
    <string name="tile_label">Focus</string>
    <!-- Tile subtitle while nothing is on. The subtitle carries the active mode's name. -->
    <string name="tile_subtitle_off">Off</string>
    <string name="tile_prefs_label">Choose a focus mode</string>

    <string name="zen_trigger_description">Managed by Focus Modes</string>

    <!-- Shown by the system when it offers rule types this app provides. -->
    <string name="core_zen_rule_type">Focus mode</string>
    <!-- Label of the rule-owner activity the system launches to configure a mode. -->
    <string name="core_zen_rule_config_label">Focus mode</string>

    <string name="channel_status_name">Active mode</string>
    <string name="channel_status_description">Shows which focus mode is on, with a shortcut to turn it off.</string>

    <!-- Ongoing notification. The title is the mode's name; this is the second line. -->
    <string name="notification_active_text">Tap to open Focus Modes.</string>
    <string name="notification_turn_off">Turn off</string>

    <!-- Picker (tile dialog + long-press grid + the widget's chevron target). -->
    <string name="picker_title">Focus</string>
    <string name="picker_off">Off</string>
    <string name="picker_selected">Selected</string>
    <!-- Trailing value on the active row, in place of a checkmark. iOS's Focus selector
         labels the on row rather than ticking it, and "On" also says what a tap will
         undo — a checkmark says only that the row is the chosen one. -->
    <string name="picker_on">On</string>
    <!-- Bottom row of the widget's picker: the one entry that is not a mode. Collapses
         iOS's "+" and its per-row Settings link into a single way into the app. -->
    <string name="picker_settings">Focus settings</string>

    <string name="health_dnd_access_missing">Focus Modes needs Do Not Disturb access before it can turn a mode on. Grant it in Settings.</string>
    <string name="health_exact_alarm_missing">Without permission for exact alarms, scheduled modes can start and end minutes or hours late.</string>
    <string name="health_post_notifications_missing">Allow notifications and Focus Modes can show which mode is on, with a one-tap way to turn it off.</string>

    <!-- e.g. "Calls: STARRED · Messages: NONE" -->
    <string name="mode_people_summary">Calls: %1$s · Messages: %2$s</string>

    <!-- Tile card in the app. -->
    <string name="tile_card_title">Quick Settings tile</string>
    <string name="action_add_tile">Add the Focus tile</string>

    <!-- What a plain tap on the tile does. Three segments of one control, so the
         labels have to survive being a third of the card's width each. -->
    <string name="tap_behavior_title">When you tap the tile</string>
    <string name="tap_behavior_last_used">Last used</string>
    <string name="tap_behavior_last_used_summary">Turns on the mode you used last, and off again when one is on.</string>
    <string name="tap_behavior_always_ask">Ask</string>
    <string name="tap_behavior_always_ask_summary">Opens the picker every time, instead of choosing a mode for you.</string>
    <string name="tap_behavior_cycle">Cycle</string>
    <string name="tap_behavior_cycle_summary">Steps through your modes in order, then back to off.</string>

    <!-- Home-screen widget. The description is shown in the widget picker. -->
    <string name="widget_label">Focus</string>
    <string name="widget_description">Your current Focus, with one tap to turn it on or off. Make it wider for a button per mode.</string>
    <!-- Widget button while nothing is on: the name of the thing, not a mode. -->
    <string name="widget_off_label">Focus</string>
    <!-- Secondary value under the active mode's name, at the largest size only. -->
    <string name="widget_value_on">On</string>
    <!--
      Announced for the widget's toggle zone. Carries the state *and* what a tap does,
      because the zone is one of two on the same widget and "Work is on" alone would
      leave a screen-reader user unable to tell the toggle from the chevron beside it.
      The double-tap wording is TalkBack's own vocabulary for a single tap.
    -->
    <string name="widget_toggle_on">%1$s, on, double-tap to turn off</string>
    <string name="widget_toggle_off">Focus, off, double-tap to turn on</string>
    <!-- The chevron zone, and the overflow cell at the wider sizes. Both open the
         picker, so both announce what opening it is for. -->
    <string name="widget_choose_mode">Choose a focus mode</string>
    <!-- Shown instead of the buttons when Do Not Disturb access is missing or no
         modes exist: both are only fixable in the app, and the widget taps through. -->
    <string name="widget_unavailable">Open Focus Modes to finish setting up</string>
    <!-- Name shown on the widget picker's static preview. Not a real mode: the preview
         cannot read the database, so it stands in for whatever the user has defined. -->
    <string name="widget_preview_mode">Work</string>

    <!-- Mode editor. -->
    <string name="mode_editor_title">Edit mode</string>
    <string name="mode_editor_name">Name</string>
    <string name="mode_editor_glyph">Icon</string>
    <string name="mode_editor_color">Colour</string>

    <string name="action_open_app">Open Focus Modes</string>
    <string name="action_save">Save</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_fix">Fix this</string>
    <string name="action_allow">Allow</string>

    <!-- ============================ Mode editor, extended ======================= -->

    <!-- Nav-up on the editor. Says "Done" rather than "Back" because leaving the
         screen is what commits the mode. -->
    <string name="ui_editor_done">Done</string>
    <string name="ui_editor_hint_applies_on_leave">Name, icon, colour, people and effects apply when you go back. Schedules save the moment you change them.</string>
    <string name="ui_editor_name_blank">A mode needs a name. The previous one is kept until you type one.</string>

    <!-- People filters, in plain language. The enum names (STARRED, CONTACTS…) are a
         storage detail and must never reach the screen. -->
    <string name="ui_people_starred">Starred contacts</string>
    <string name="ui_people_contacts">All contacts</string>
    <string name="ui_people_anyone">Anyone</string>
    <string name="ui_people_none">No one</string>

    <!-- Short forms for the selector chips, where the row label already says
         "Calls from:" and repeating "contacts" four times is noise. -->
    <string name="ui_people_starred_short">Starred</string>
    <string name="ui_people_contacts_short">Contacts</string>
    <string name="ui_people_anyone_short">Anyone</string>
    <string name="ui_people_none_short">No one</string>

    <string name="ui_editor_people_title">Who gets through</string>
    <!-- e.g. "Calls from: Starred contacts" -->
    <string name="ui_editor_calls_from">Calls from: %1$s</string>
    <string name="ui_editor_messages_from">Messages from: %1$s</string>
    <string name="ui_editor_repeat_callers">Let repeat callers through</string>
    <string name="ui_editor_repeat_callers_summary">Someone who calls again within 15 minutes rings even when their calls are silenced.</string>
    <string name="ui_editor_starred_explainer">Starred contacts are your allowlist: star someone in Contacts and they get through in every mode set to Starred contacts.</string>
    <string name="ui_editor_open_contacts">Open Contacts</string>

    <!-- Device effects. -->
    <string name="ui_editor_effects_title">While this mode is on</string>
    <string name="ui_editor_effect_grayscale">Greyscale screen</string>
    <string name="ui_editor_effect_dim_wallpaper">Dim the wallpaper</string>
    <string name="ui_editor_effect_night_mode">Dark theme</string>
    <string name="ui_editor_effects_summary">Your phone decides whether to honour these. Some Android skins ignore one or more of them.</string>

    <!-- ================================ Schedules =============================== -->

    <string name="ui_schedules_title">Schedules</string>
    <string name="ui_schedules_empty">No schedules yet. A schedule turns this mode on and off on its own.</string>
    <string name="ui_schedules_add">Add a schedule</string>
    <!-- e.g. "Weekdays · 09:00 – 17:00" -->
    <string name="ui_schedule_summary">%1$s · %2$s</string>
    <string name="ui_schedule_range">%1$s – %2$s</string>
    <!-- Shown when the window runs past midnight, so the end time is tomorrow's. -->
    <string name="ui_schedule_range_next_day">%1$s – %2$s next day</string>
    <!-- e.g. "Next: Mon 09:00" -->
    <string name="ui_schedule_next">Next: %1$s</string>
    <string name="ui_schedule_disabled">Off</string>
    <string name="ui_schedule_no_days">Runs on no days, so it never starts.</string>
    <string name="ui_schedule_unreadable">This schedule cannot be read. Delete it and add a new one.</string>
    <string name="ui_schedule_overlaps">Overlaps another schedule. Only one mode can be on, so whichever boundary comes last wins.</string>
    <string name="ui_schedule_exact_alarm_hint">Exact alarms are not allowed yet, so this schedule can start and end minutes or hours late.</string>

    <!-- Day sets. Named rather than spelled out, because "Mon, Tue, Wed, Thu, Fri"
         is harder to read at a glance than "Weekdays". -->
    <string name="ui_days_every_day">Every day</string>
    <string name="ui_days_weekdays">Weekdays</string>
    <string name="ui_days_weekends">Weekends</string>
    <string name="ui_days_none">No days</string>

    <!-- Schedule editor dialog. -->
    <string name="ui_schedule_editor_new">New schedule</string>
    <string name="ui_schedule_editor_edit">Edit schedule</string>
    <string name="ui_schedule_editor_days">Days</string>
    <string name="ui_schedule_editor_start">Starts</string>
    <string name="ui_schedule_editor_end">Ends</string>
    <string name="ui_schedule_editor_enabled">Schedule is on</string>
    <string name="ui_schedule_editor_wraps">Runs past midnight and ends the next morning.</string>
    <string name="ui_schedule_editor_same_time">Start and end are the same, so this covers the whole day.</string>
    <string name="ui_action_delete">Delete</string>
    <string name="ui_time_type_it">Type the time</string>
    <string name="ui_time_pick_on_dial">Use the dial</string>

    <!-- Glyph names. Used as content descriptions in the icon picker: a bare
         silhouette with no label is unreadable to a screen reader. -->
    <string name="glyph_briefcase">Briefcase</string>
    <string name="glyph_moon">Moon</string>
    <string name="glyph_person">Person</string>
    <string name="glyph_book">Book</string>
    <string name="glyph_home">Home</string>
    <string name="glyph_dumbbell">Dumbbell</string>
    <string name="glyph_star">Star</string>
</resources>
