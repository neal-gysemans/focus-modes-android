<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Focus Modes</string>
    <!-- Quick Settings tile label. Kept short: the platform truncates past ~18 chars,
         and HyperOS hides it entirely, so it must never be load-bearing. -->
    <string name="tile_label">Focus</string>
    <!-- Tile subtitle while nothing is on. The subtitle carries the active mode's name. -->
    <string name="tile_subtitle_off">Off</string>
    <string name="tile_prefs_label">Choose a focus mode</string>

    <string name="zen_trigger_description">Managed by Focus Modes</string>

    <!-- Shown by the system when it offers rule types this app provides. -->
    <string name="core_zen_rule_type">Focus mode</string>
    <!-- Label of the rule-owner activity the system launches to configure a mode. -->
    <string name="core_zen_rule_config_label">Focus mode</string>

    <string name="channel_status_name">Active mode</string>
    <string name="channel_status_description">Shows which focus mode is on, with a shortcut to turn it off.</string>

    <!-- Ongoing notification. The title is the mode's name; this is the second line. -->
    <string name="notification_active_text">Tap to open Focus Modes.</string>
    <string name="notification_turn_off">Turn off</string>

    <!-- Picker (tile dialog + long-press grid). -->
    <string name="picker_title">Focus</string>
    <string name="picker_off">Off</string>
    <string name="picker_selected">Selected</string>

    <string name="health_dnd_access_missing">Focus Modes needs Do Not Disturb access before it can turn a mode on. Grant it in Settings.</string>
    <string name="health_exact_alarm_missing">Without permission for exact alarms, scheduled modes can start and end minutes or hours late.</string>
    <string name="health_post_notifications_missing">Allow notifications and Focus Modes can show which mode is on, with a one-tap way to turn it off.</string>

    <!-- e.g. "Calls: STARRED · Messages: NONE" -->
    <string name="mode_people_summary">Calls: %1$s · Messages: %2$s</string>

    <!-- Tile card in the app. -->
    <string name="tile_card_title">Quick Settings tile</string>
    <string name="action_add_tile">Add the Focus tile</string>

    <!-- What a plain tap on the tile does. Three segments of one control, so the
         labels have to survive being a third of the card's width each. -->
    <string name="tap_behavior_title">When you tap the tile</string>
    <string name="tap_behavior_last_used">Last used</string>
    <string name="tap_behavior_last_used_summary">Turns on the mode you used last, and off again when one is on.</string>
    <string name="tap_behavior_always_ask">Ask</string>
    <string name="tap_behavior_always_ask_summary">Opens the picker every time, instead of choosing a mode for you.</string>
    <string name="tap_behavior_cycle">Cycle</string>
    <string name="tap_behavior_cycle_summary">Steps through your modes in order, then back to off.</string>

    <!-- Home-screen widget. The description is shown in the widget picker. -->
    <string name="widget_label">Focus</string>
    <string name="widget_description">Your current Focus, with one tap to turn it on or off. Make it wider for a button per mode.</string>
    <!-- Widget button while nothing is on: the name of the thing, not a mode. -->
    <string name="widget_off_label">Focus</string>
    <!-- Announced for the whole widget so TalkBack does not read a bare glyph. -->
    <string name="widget_state_on">%1$s is on</string>
    <string name="widget_state_off">No focus mode is on</string>
    <!-- Shown instead of the buttons when Do Not Disturb access is missing or no
         modes exist: both are only fixable in the app, and the widget taps through. -->
    <string name="widget_unavailable">Open Focus Modes to finish setting up</string>
    <!-- Name shown on the widget picker's static preview. Not a real mode: the preview
         cannot read the database, so it stands in for whatever the user has defined. -->
    <string name="widget_preview_mode">Work</string>

    <!-- Mode editor. -->
    <string name="mode_editor_title">Edit mode</string>
    <string name="mode_editor_name">Name</string>
    <string name="mode_editor_glyph">Icon</string>
    <string name="mode_editor_color">Colour</string>

    <string name="action_open_app">Open Focus Modes</string>
    <string name="action_save">Save</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_fix">Fix this</string>
    <string name="action_allow">Allow</string>

    <!-- Glyph names. Used as content descriptions in the icon picker: a bare
         silhouette with no label is unreadable to a screen reader. -->
    <string name="glyph_briefcase">Briefcase</string>
    <string name="glyph_moon">Moon</string>
    <string name="glyph_person">Person</string>
    <string name="glyph_book">Book</string>
    <string name="glyph_home">Home</string>
    <string name="glyph_dumbbell">Dumbbell</string>
    <string name="glyph_star">Star</string>
</resources>
