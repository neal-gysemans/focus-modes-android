<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately NO android.permission.INTERNET. Nothing in this app needs the
      network, and not holding the permission is the strongest possible statement
      that focus data (who you allow through, when you sleep) never leaves the
      device. Adding it later would be a privacy regression, not a feature.
    -->

    <!-- Gate on the AutomaticZenRule API. The user grants it via Settings
         (ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS); see health/PermissionHealth. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Schedule boundaries must land on the minute, and at 23:00 / 07:00 the
         device is deep in doze. Revocable from API 33, so always checked first. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Alarms and the system's belief about rule state are both lost on reboot,
         so BootReceiver reconciles from scratch. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The ongoing "Work is on, tap to turn off" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package-visibility filtering makes resolveActivity() return null for Settings
      intents unless the target action is declared here. health/PermissionHealth
      probes both screens before offering a "Fix this" button, so without these
      declarations it would report every Settings screen as missing and hide the
      only way the user can grant DND access.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.AUTOMATIC_ZEN_RULE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_POLICY_ACCESS_SETTINGS" />
        </intent>
        <!-- Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM: without these declarations the
             exact-alarm health check reports its own "Fix this" button as unreachable.
             Two entries because the per-app screen ("package:" data) and the plain
             "Alarms & reminders" list are different Settings activities, and the
             visibility probe has to match each one's filter. -->
        <intent>
            <action android:name="android.settings.REQUEST_SCHEDULE_EXACT_ALARM" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_SCHEDULE_EXACT_ALARM" />
            <data android:scheme="package" />
        </intent>
        <!--
          The Contacts app, for the mode editor's "star someone and they get through"
          explainer. Two forms because CATEGORY_APP_CONTACTS is the documented way in
          and is what a stock launcher-registered Contacts app matches, while some OEM
          builds (HyperOS among them) only expose the provider's VIEW activity. Without
          these declarations resolveActivity() returns null for both and the button is
          hidden even though the app is installed.

          Note this is visibility only: the app never reads a single contact, and holds
          no READ_CONTACTS permission. The allowlist is enforced system-side by
          ZenPolicy, from stars the user sets in Contacts itself.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
    </queries>

    <application
        android:name=".FocusModesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusModes">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FocusModes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The tile's long-press target. MUST be exported and carry the
          QS_TILE_PREFERENCES action, or long-pressing the tile does nothing.

          Deliberately a fast mode picker rather than a settings screen: press-and-hold
          on an iOS Control Center control gives you the control itself, larger.
          excludeFromRecents + singleTop because it is a momentary overlay — it should
          never accumulate in the recents list or stack on itself.
        -->
        <activity
            android:name=".tile.TilePrefsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/tile_prefs_label"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FocusModes.Translucent">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!--
          Quick Settings tile — the app's primary surface.
          ACTIVE_TILE: the app pushes updates via requestListeningState instead of
          only refreshing while the shade is open.
          TOGGLEABLE_TILE: tells the system this is an on/off control, so it is
          rendered and announced as a switch rather than a shortcut.
        -->
        <service
            android:name=".tile.FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!--
          Owner of every AutomaticZenRule this app creates. addAutomaticZenRule
          rejects a rule with no owner, and the modern owner is an exported activity
          handling ACTION_AUTOMATIC_ZEN_RULE with the ruleType meta-data — so all
          three attributes below are load-bearing, not boilerplate.
          ruleInstanceLimit is deliberately omitted: omitting it means "unlimited",
          and the user may define as many modes as they like.
        -->
        <activity
            android:name=".zen.ZenRuleConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/core_zen_rule_config_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.zen.automatic.ruleType"
                android:value="@string/core_zen_rule_type" />
        </activity>

        <!--
          Learns that a human turned one of our modes on or off from a system
          surface. Declared here so a status change can wake a dead process; the
          Application also registers the same receiver at runtime, because HyperOS
          broadcast delivery to manifest receivers could not be proven from code
          alone. Both paths are idempotent, so double delivery is harmless.
        -->
        <receiver
            android:name=".zen.ZenStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE_STATUS_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Fires on the next schedule boundary; carries no payload, just "recompute".
          The intent-filter is for a different signal: revoking the exact-alarm grant
          deletes every alarm we set, so when the user grants it again we have to
          re-arm. That broadcast is documented to reach manifest receivers.
        -->
        <receiver
            android:name=".schedule.ScheduleAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Reconcile after a reboot or an app update; both wipe armed alarms. -->
        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The ongoing notification's "Turn off" action. -->
        <receiver
            android:name=".notification.TurnOffReceiver"
            android:exported="false" />

    </application>

</manifest>
